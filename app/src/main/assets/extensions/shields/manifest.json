{
  "manifest_version": 2,
  "name": "SonderWeb shields",
  "version": "1.0",
  "description": "Keeps your IP address out of WebRTC, opens real pages instead of AMP copies, and skips tracking redirect links.",
  "browser_specific_settings": { "gecko": { "id": "shields@sonderweb" } },
  "permissions": ["privacy", "webRequest", "webRequestBlocking", "<all_urls>"],
  "background": { "scripts": ["shields.js"] },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["amp.js"],
      "run_at": "document_start"
    }
  ]
}
