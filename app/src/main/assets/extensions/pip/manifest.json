{
  "manifest_version": 2,
  "name": "SonderWeb video helper",
  "version": "1.4",
  "description": "Tells the browser when a video plays, fills the picture-in-picture window with it, and keeps fullscreen videos in place.",
  "browser_specific_settings": { "gecko": { "id": "pip@sonderweb" } },
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["pip.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
