<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Downloads on Android 8 and 9 (newer versions use the shared Downloads folder). -->
    <external-files-path name="downloads" path="Download/" />
    <!-- App updates, downloaded before Android's installer opens them. -->
    <cache-path name="updates" path="updates/" />
    <!-- SonderCircle, downloaded before Android's installer opens it. -->
    <cache-path name="circle" path="circle/" />
    <!-- A photo taken for an image search. -->
    <cache-path name="images" path="images/" />
    <!-- Everything packed up for the other SonderWeb app to copy in. -->
    <cache-path name="transfer" path="transfer/" />
</paths>
