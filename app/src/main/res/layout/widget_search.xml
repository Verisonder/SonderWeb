<?xml version="1.0" encoding="utf-8"?>
<!-- The home screen search widget: logo, "Search", voice search and image search. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/widget_pill"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_gravity="center_vertical"
        android:background="@drawable/widget_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="13dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_logo" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_search"
            android:textColor="#F4F4F4"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_voice"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:contentDescription="@string/widget_voice"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_mic" />

        <ImageView
            android:id="@+id/widget_image"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:contentDescription="@string/widget_image"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_image_search" />
    </LinearLayout>
</FrameLayout>
